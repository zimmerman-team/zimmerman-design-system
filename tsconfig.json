{
  "compilerOptions": {
    "target": "es5",  
    "declaration": true,
    "outDir": "dist",
    "declarationDir": "dist/types",
    "baseUrl": "./src",
    "paths": {
      "theme": ["app/theme/index.js"],
       "assets":["app/assets"],
    },
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "src/**/*"
  ]
}
